<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ view.title }} · {{ request.trace_id }}</title>
  <style>
    :root {
      --canvas: #f4f7fb;
      --paper: #ffffff;
      --paper-soft: #f9fbfd;
      --ink: #102443;
      --ink-strong: #081a36;
      --muted: #60708a;
      --faint: #8997ac;
      --line: #d8e0ec;
      --line-strong: #c4cfdd;
      --blue: #1769e0;
      --blue-soft: #eaf2ff;
      --cyan: #0796aa;
      --cyan-soft: #e8f8fa;
      --teal: #087d78;
      --green: #18815a;
      --green-soft: #e8f6ef;
      --orange: #e44c3b;
      --orange-soft: #fff0ed;
      --amber: #b8750b;
      --amber-soft: #fff7e7;
      --slate: #68778d;
      --shadow: 0 14px 38px rgba(21, 43, 77, 0.08);
      --label-width: 188px;
      --radius: 14px;
      --sans: "Segoe UI Variable", "MiSans", "PingFang SC",
        "Microsoft YaHei", sans-serif;
      --mono: "Cascadia Code", "JetBrains Mono", Consolas, monospace;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      background: var(--canvas);
    }

    body {
      margin: 0;
      color: var(--ink);
      background:
        linear-gradient(180deg, #fbfcff 0, var(--canvas) 460px);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.55;
    }

    button, input { font: inherit; }

    button:focus-visible,
    summary:focus-visible {
      outline: 3px solid rgba(23, 105, 224, 0.28);
      outline-offset: 2px;
    }

    .page {
      width: min(1580px, calc(100% - 40px));
      margin: 0 auto;
      padding: 22px 0 56px;
    }

    .masthead {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      padding: 2px 2px 18px;
    }

    .masthead h1 {
      margin: 0;
      color: var(--ink-strong);
      font-size: clamp(26px, 3vw, 38px);
      line-height: 1.1;
      font-weight: 760;
      letter-spacing: -0.035em;
    }

    .trace-name {
      margin-top: 8px;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .masthead-side {
      display: grid;
      justify-items: end;
      gap: 10px;
      min-width: 320px;
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 4px 10px;
      border: 1px solid var(--line-strong);
      border-radius: 7px;
      background: var(--paper);
      color: var(--muted);
      font-size: 11px;
      font-weight: 760;
      letter-spacing: 0.06em;
    }

    .badge-blue {
      border-color: rgba(23, 105, 224, 0.35);
      background: var(--blue-soft);
      color: var(--blue);
    }

    .badge-green {
      border-color: rgba(24, 129, 90, 0.3);
      background: var(--green-soft);
      color: var(--green);
    }

    .meta-line {
      color: var(--muted);
      font-family: var(--mono);
      font-size: 12px;
      text-align: right;
    }

    .stack {
      display: grid;
      gap: 14px;
    }

    .panel {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--paper);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(150px, 0.55fr));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--paper);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .conclusion {
      padding: 22px 24px;
      border-right: 1px solid var(--line);
    }

    .eyebrow {
      margin-bottom: 8px;
      color: var(--blue);
      font-size: 12px;
      font-weight: 780;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .conclusion h2 {
      max-width: 920px;
      margin: 0;
      color: var(--ink-strong);
      font-size: clamp(20px, 2vw, 27px);
      line-height: 1.35;
      font-weight: 740;
      letter-spacing: -0.025em;
    }

    .conclusion p {
      max-width: 960px;
      margin: 12px 0 0;
      color: var(--muted);
    }

    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 9px;
      border-radius: 6px;
      background: var(--paper-soft);
      border: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      font-weight: 680;
    }

    .chip-good {
      color: var(--green);
      border-color: rgba(24, 129, 90, 0.25);
      background: var(--green-soft);
    }

    .chip-warn {
      color: var(--amber);
      border-color: rgba(184, 117, 11, 0.25);
      background: var(--amber-soft);
    }

    .metric {
      display: grid;
      align-content: center;
      justify-items: center;
      min-height: 172px;
      padding: 18px 12px;
      border-right: 1px solid var(--line);
      text-align: center;
    }

    .metric:last-child { border-right: 0; }

    .metric-label {
      color: var(--muted);
      font-weight: 660;
    }

    .metric-value {
      margin-top: 10px;
      color: var(--blue);
      font-family: var(--mono);
      font-size: clamp(29px, 3vw, 46px);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.05em;
    }

    .metric-value small {
      margin-left: 3px;
      font-size: 15px;
      letter-spacing: 0;
    }

    .metric-note {
      margin-top: 12px;
      color: var(--faint);
      font-size: 12px;
    }

    .section-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 15px 18px 12px;
      border-bottom: 1px solid var(--line);
    }

    .section-head h2 {
      margin: 0;
      color: var(--ink-strong);
      font-size: 17px;
      line-height: 1.35;
    }

    .section-head p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    .boundary-body {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) 44px minmax(220px, 1fr);
      align-items: stretch;
      gap: 12px;
      padding: 14px 18px 18px;
    }

    .boundary-body.has-presentation {
      grid-template-columns: minmax(200px, 1fr) 34px minmax(200px, 1fr) 34px minmax(200px, 1fr);
    }

    .boundary-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 12px;
      min-height: 76px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--paper-soft);
    }

    .boundary-icon {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: var(--blue-soft);
      color: var(--blue);
      font-size: 18px;
      font-weight: 800;
    }

    .boundary-name {
      color: var(--ink-strong);
      font-weight: 740;
    }

    .boundary-source {
      margin-top: 3px;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      overflow-wrap: anywhere;
    }

    .boundary-time {
      color: var(--blue);
      font-family: var(--mono);
      font-size: 16px;
      font-weight: 720;
      text-align: right;
    }

    .boundary-confidence {
      margin-top: 3px;
      color: var(--faint);
      font-size: 11px;
      text-align: right;
    }

    .boundary-arrow {
      display: grid;
      place-items: center;
      color: var(--faint);
      font-size: 24px;
    }

    .boundary-note {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      padding: 12px 14px;
      border: 1px solid rgba(184, 117, 11, 0.25);
      border-radius: 10px;
      background: var(--amber-soft);
      color: #76500f;
      font-size: 12px;
    }

    .timeline-toolbar {
      display: inline-flex;
      gap: 6px;
      padding: 3px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--paper-soft);
    }

    .timeline-toolbar button {
      padding: 5px 10px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 680;
    }

    .timeline-toolbar button.active {
      background: var(--paper);
      color: var(--blue);
      box-shadow: 0 1px 4px rgba(20, 43, 78, 0.12);
    }

    .timeline-toolbar .tool-divider {
      width: 1px;
      margin: 3px 2px;
      background: var(--line-strong);
    }

    .depth-control {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0 7px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 680;
      white-space: nowrap;
    }

    .depth-control input {
      width: 88px;
      accent-color: var(--blue);
      cursor: pointer;
    }

    .depth-control output {
      min-width: 18px;
      color: var(--blue);
      font-family: var(--mono);
      text-align: right;
    }

    .timeline-viewport {
      position: relative;
      overflow: hidden;
      background: var(--paper);
    }

    .timeline-chart {
      min-width: 0;
      position: relative;
    }

    .trace-canvas {
      display: block;
      width: 100%;
      outline: none;
      cursor: crosshair;
      touch-action: none;
    }

    .trace-canvas.is-panning { cursor: grabbing; }

    .trace-tooltip {
      position: absolute;
      z-index: 12;
      max-width: 340px;
      padding: 8px 10px;
      border: 1px solid rgba(28, 47, 77, 0.2);
      border-radius: 7px;
      background: rgba(18, 31, 51, 0.94);
      box-shadow: 0 8px 24px rgba(11, 25, 45, 0.2);
      color: #f5f8fc;
      font-size: 11px;
      line-height: 1.45;
      pointer-events: none;
      white-space: nowrap;
    }

    .trace-tooltip strong {
      display: block;
      max-width: 310px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .trace-tooltip span {
      color: #b9c9dd;
      font-family: var(--mono);
    }

    .timeline-status {
      flex: 1;
      color: var(--blue);
      text-align: center;
    }

    .callstack-color-key {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }

    .callstack-color-key i {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      box-shadow: inset 0 0 0 1px rgba(19, 39, 67, 0.16);
    }

    .cpu-distribution {
      display: grid;
      grid-template-columns: 208px minmax(0, 1fr);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: #f9fbfd;
    }

    .cpu-distribution-head {
      display: grid;
      align-content: center;
      gap: 2px;
      min-height: 58px;
      padding: 9px 14px;
      border-right: 1px solid var(--line);
    }

    .cpu-distribution-head strong {
      color: #27374d;
      font-size: 11px;
      font-weight: 700;
    }

    .cpu-distribution-head span {
      color: var(--faint);
      font-family: var(--mono);
      font-size: 9px;
    }

    .cpu-distribution-body {
      display: grid;
      align-content: center;
      gap: 8px;
      min-width: 0;
      padding: 9px 14px;
    }

    .cpu-distribution-bar {
      display: flex;
      height: 9px;
      overflow: hidden;
      border: 1px solid rgba(27, 49, 78, 0.14);
      border-radius: 3px;
      background: #e8edf3;
    }

    .cpu-distribution-segment {
      min-width: 2px;
      background: var(--cpu-color);
      box-shadow: inset -1px 0 rgba(255, 255, 255, 0.45);
    }

    .cpu-core-list {
      display: flex;
      gap: 5px 10px;
      overflow: hidden;
      color: #526176;
      font-family: var(--mono);
      font-size: 9px;
      white-space: nowrap;
    }

    .cpu-core-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .cpu-core-chip::before {
      width: 7px;
      height: 7px;
      border-radius: 2px;
      background: var(--cpu-color);
      box-shadow: inset 0 0 0 1px rgba(19, 39, 67, 0.14);
      content: "";
    }

    .cpu-core-chip b {
      color: #27374d;
      font-weight: 700;
    }

    .timeline-axis {
      display: grid;
      grid-template-columns: var(--label-width) minmax(780px, 1fr);
      min-height: 38px;
      border-bottom: 1px solid var(--line);
      background: var(--paper-soft);
    }

    .timeline-axis-label {
      display: flex;
      align-items: center;
      padding: 0 14px;
      border-right: 1px solid var(--line);
      color: var(--faint);
      font-family: var(--mono);
      font-size: 10px;
    }

    .axis-track {
      position: relative;
      margin: 0 12px;
    }

    .axis-mark {
      position: absolute;
      top: 10px;
      transform: translateX(-50%);
      color: var(--muted);
      font-family: var(--mono);
      font-size: 10px;
      white-space: nowrap;
    }

    .axis-mark.is-start { transform: none; }
    .axis-mark.is-end { transform: translateX(-100%); }

    .timeline-body {
      position: relative;
      isolation: isolate;
    }

    .lane-row {
      display: grid;
      grid-template-columns: var(--label-width) minmax(780px, 1fr);
      min-height: 38px;
      border-bottom: 1px solid var(--line);
    }

    .lane-row:last-child { border-bottom: 0; }

    .lane-label {
      display: grid;
      align-content: center;
      gap: 1px;
      padding: 7px 14px;
      border-right: 1px solid var(--line);
      background: var(--paper-soft);
      overflow: hidden;
    }

    .lane-label strong {
      overflow: hidden;
      color: var(--ink);
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lane-label span {
      overflow: hidden;
      color: var(--faint);
      font-family: var(--mono);
      font-size: 9px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lane-track {
      position: relative;
      margin: 0 12px;
      background-image:
        linear-gradient(to right, rgba(24, 54, 95, 0.075) 1px, transparent 1px);
      background-size: 10% 100%;
    }

    .trace-block {
      position: absolute;
      display: block;
      height: 15px;
      min-width: 3px;
      padding: 0 6px;
      overflow: hidden;
      border: 1px solid rgba(23, 105, 224, 0.38);
      border-radius: 4px;
      background: #dceaff;
      color: #154f9d;
      cursor: pointer;
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 650;
      line-height: 13px;
      text-align: left;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: filter 120ms ease, transform 120ms ease;
      z-index: 3;
    }

    .trace-block:hover {
      filter: saturate(1.18) brightness(0.98);
      transform: translateY(-1px);
      z-index: 7;
    }

    .role-stage {
      border-color: rgba(23, 105, 224, 0.3);
      background: var(--blue-soft);
      color: var(--blue);
    }

    .role-critical {
      border-color: rgba(228, 76, 59, 0.55);
      background: linear-gradient(90deg, #ff7968, var(--orange));
      color: #fff;
    }

    .role-target {
      border-color: rgba(23, 105, 224, 0.45);
      background: #cfe2ff;
      color: #124d9b;
    }

    .role-cross {
      border-color: rgba(7, 150, 170, 0.45);
      background: var(--cyan-soft);
      color: #086d7b;
    }

    .role-system {
      border-color: rgba(104, 119, 141, 0.35);
      background: #edf1f6;
      color: #56657a;
    }

    .role-frame-actual,
    .role-frame-expected {
      border-color: rgba(7, 150, 170, 0.45);
      background: #d8f5f7;
      color: #08707c;
    }

    .role-frame-expected {
      border-style: dashed;
      background: #f3fbfc;
    }

    .role-render-frame {
      border-color: rgba(8, 125, 120, 0.55);
      background: var(--teal);
      color: #fff;
    }

    .role-state-running {
      border-color: rgba(24, 129, 90, 0.4);
      background: #bfe7d1;
      color: #176b4c;
    }

    .role-state-runnable {
      border-color: rgba(184, 117, 11, 0.45);
      background: #ffe2a7;
      color: #825508;
    }

    .role-state-sleep {
      border-color: rgba(104, 119, 141, 0.45);
      background: #dce3ec;
      color: #526176;
    }

    .role-state-blocked {
      border-color: rgba(228, 76, 59, 0.4);
      background: #ffd2cc;
      color: #9f3024;
    }

    .role-state-other {
      border-color: var(--line-strong);
      background: #eef1f5;
      color: var(--slate);
    }

    .boundary-pin {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 0;
      border-left: 1px dashed rgba(23, 105, 224, 0.72);
      z-index: 2;
      pointer-events: none;
    }

    .boundary-pin span {
      position: absolute;
      top: -25px;
      left: 0;
      transform: translateX(-50%);
      padding: 2px 5px;
      border-radius: 4px;
      background: var(--blue);
      color: #fff;
      font-size: 9px;
      font-weight: 720;
      white-space: nowrap;
    }

    .boundary-pin.is-start span {
      left: 3px;
      transform: none;
    }

    .boundary-pin.is-end span {
      left: auto;
      right: 3px;
      transform: none;
    }

    .link-layer {
      position: absolute;
      inset: 0 12px 0 calc(var(--label-width) + 12px);
      width: auto;
      height: 100%;
      overflow: visible;
      pointer-events: none;
      z-index: 6;
    }

    .link-layer path {
      fill: none;
      stroke: rgba(7, 150, 170, 0.72);
      stroke-width: 1.5;
      stroke-dasharray: 3 2;
    }

    .timeline-empty {
      padding: 28px;
      color: var(--muted);
      text-align: center;
    }

    .timeline-footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 10px 18px;
      border-top: 1px solid var(--line);
      background: var(--paper-soft);
      color: var(--muted);
      font-size: 11px;
    }

    .diagnostic-grid {
      display: grid;
      grid-template-columns: minmax(320px, 0.85fr) minmax(500px, 1.15fr);
      gap: 14px;
    }

    .card-body { padding: 16px 18px 18px; }

    .stage-list {
      display: grid;
      gap: 12px;
    }

    .stage-row {
      display: grid;
      grid-template-columns: minmax(150px, 0.7fr) minmax(180px, 1.5fr) 76px;
      align-items: center;
      gap: 12px;
    }

    .stage-name {
      overflow: hidden;
      color: var(--ink);
      font-size: 12px;
      font-weight: 650;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .stage-bar {
      height: 16px;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: #f0f3f7;
      overflow: hidden;
    }

    .stage-fill {
      height: 100%;
      min-width: 2px;
      border-radius: 3px;
      background: var(--blue);
    }

    .stage-fill.critical {
      background: var(--orange);
    }

    .stage-duration {
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      text-align: right;
    }

    .kpi-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(100px, 1fr));
      gap: 9px;
    }

    .kpi {
      padding: 10px 11px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--paper-soft);
    }

    .kpi-label {
      color: var(--muted);
      font-size: 10px;
    }

    .kpi-value {
      margin-top: 4px;
      color: var(--ink-strong);
      font-family: var(--mono);
      font-size: 20px;
      font-weight: 720;
    }

    .kpi-value.green { color: var(--green); }
    .kpi-value.amber { color: var(--amber); }

    .assessment {
      margin-top: 12px;
      padding: 11px 12px;
      border-left: 3px solid var(--blue);
      background: var(--blue-soft);
      color: #294d7c;
      font-size: 12px;
    }

    .findings {
      display: grid;
      gap: 10px;
      padding: 14px 18px 18px;
    }

    .finding {
      display: grid;
      grid-template-columns: 8px minmax(180px, 0.65fr) minmax(320px, 1.35fr);
      gap: 14px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--paper-soft);
    }

    .finding-mark {
      border-radius: 999px;
      background: var(--blue);
    }

    .finding-mark.high,
    .finding-mark.critical { background: var(--orange); }
    .finding-mark.medium { background: var(--amber); }

    .finding h3 {
      margin: 0;
      color: var(--ink-strong);
      font-size: 14px;
    }

    .finding-meta {
      margin-top: 5px;
      color: var(--muted);
