# DeepSeek remains the Qoder Agent SDK's BYOK model provider.
TRACE_AGENT_LLM_PROVIDER=deepseek
TRACE_AGENT_LLM_MODEL=deepseek-v4-pro-pg
TRACE_AGENT_LLM_BASE_URL=https://api.deepseek.com/anthropic

# Copy this file to .env and fill in your existing DeepSeek API Key.
DEEPSEEK_API_KEY=

# Optional: omit this when reusing an authenticated qodercli session.
QODER_PERSONAL_ACCESS_TOKEN=
