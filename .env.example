# Claude Agent SDK is the primary (default) agent runtime, using an
# Anthropic-compatible endpoint. DeepSeek BYOK is one interchangeable model
# provider; other Anthropic-compatible providers can be configured the same way.
TRACE_AGENT_LLM_PROVIDER=deepseek
TRACE_AGENT_LLM_MODEL=deepseek-v4-pro-pg
TRACE_AGENT_LLM_BASE_URL=https://api.deepseek.com/anthropic

# Copy this file to .env and fill in your existing DeepSeek API Key.
DEEPSEEK_API_KEY=

# Claude Code natively reads these two spellings. Supply either one; the
# agent runtime forwards it to the Claude Code subprocess as ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Optional Qoder adapter auth. Only used when switching to `--agent qoder`.
QODER_PERSONAL_ACCESS_TOKEN=
